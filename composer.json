{
    "name": "microscrap/scrapyard-linux",
    "description": "Native Linux connection drivers for the ScrapyardIO GPIO framework: gpiod, i2c-dev, spidev, termios and sysfs PWM over ext-posi",
    "type": "library",
    "version": "0.10.1",
    "keywords": [
        "scrapyard-io",
        "gpio",
        "linux",
        "posix",
        "drivers"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": "^8.4|^8.5|^8.6",
        "ext-posi": "^0.10.0",
        "gpio/contracts": "^0.10.0",
        "gpio/digital": "^0.10.0",
        "gpio/i2c": "^0.10.0",
        "gpio/nuts-and-bolts": "^0.10.0",
        "gpio/pwm": "^0.10.0",
        "gpio/spi": "^0.10.0",
        "gpio/uart": "^0.10.0",
        "microscrap/gpio": "^0.10.0",
        "microscrap/i2c": "^0.10.0",
        "microscrap/spi": "^0.10.0",
        "microscrap/uart": "^0.10.0",
        "venusian-voyager/nuts-and-bolts": "^0.10.0"
    },
    "require-dev": {
        "pestphp/pest": "^4",
        "venusian-voyager/config": "^0.10.0",
        "venusian-voyager/vessel": "^0.10.0"
    },
    "autoload": {
        "psr-4": {
            "Microscrap\\ScrapyardLinux\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Microscrap\\ScrapyardLinux\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.10.x-dev"
        },
        "venusian": {
            "providers": [
                "Microscrap\\ScrapyardLinux\\Providers\\ScrapyardLinuxServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
